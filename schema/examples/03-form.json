{
  "id": "registro",
  "title": "Registro",
  "root": {
    "type": "container",
    "id": "root",
    "padding": 16,
    "spacing": 16,
    "children": [
      {
        "type": "text",
        "id": "h",
        "text": "Crear cuenta",
        "style": "headlineSmall",
        "a11y": {
          "content_description": "Crear cuenta",
          "is_heading": true
        }
      },
      {
        "type": "text_field",
        "id": "f_name",
        "state_key": "name",
        "label": "Full name",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Name is required"
          }
        ]
      },
      {
        "type": "text_field",
        "id": "f_email",
        "state_key": "email",
        "label": "Email",
        "input_type": "EMAIL",
        "helper_text": "We will send you a code",
        "validation_rules": [
          {
            "type": "REQUIRED",
            "error_message": "Email is required"
          },
          {
            "type": "EMAIL",
            "error_message": "Not a valid email"
          }
        ]
      },
      {
        "type": "text_field",
        "id": "f_pass",
        "state_key": "password",
        "label": "Password",
        "input_type": "PASSWORD",
        "validation_rules": [
          {
            "type": "MIN_LENGTH",
            "value": "8",
            "error_message": "At least 8 characters"
          }
        ]
      },
      {
        "type": "switch",
        "id": "sw_empresa",
        "state_key": "es_empresa",
        "label": "¿Cuenta empresarial?"
      },
      {
        "type": "text_field",
        "id": "f_nit",
        "state_key": "nit",
        "label": "NIT",
        "visible_if": "es_empresa",
        "validation_rules": [
          {
            "type": "CUSTOM",
            "value": "COLOMBIAN_NIT",
            "error_message": "Not a valid tax id"
          }
        ]
      },
      {
        "type": "button",
        "id": "btn_submit",
        "title": "Crear cuenta",
        "is_full_width": true,
        "actions": [
          {
            "type": "submit_form",
            "endpoint": "/ms-cuentas/registro",
            "method": "POST",
            "payload": {
              "name": "{{state.nombre}}",
              "email": "{{state.email}}",
              "empresarial": "{{state.es_empresa}}",
              "origen": "mobile"
            }
          }
        ]
      }
    ]
  }
}
